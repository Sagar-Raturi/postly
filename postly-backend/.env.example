# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Core -------------------------------------------------------------------
# Required in production. Local dev falls back to an insecure built-in key.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---------------------------------------------------------------
# Omit entirely to use SQLite at postly-backend/db.sqlite3 (fine for a first run).
# Postgres:
# DATABASE_URL=postgres://postly:postly@localhost:5432/postly

# --- Hosts, CORS and CSRF ---------------------------------------------------
# Comma-separated. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API from a browser. Never a wildcard: the API
# answers credentialed requests, so an open CORS policy would hand any site a
# logged-in caller. The Next.js dev server:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Origins whose unsafe requests Django will accept a CSRF token from. Must
# include the Next.js origin, or every save 403s. Required in production.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Sessions ---------------------------------------------------------------
# Leave unset in development: both halves are on localhost, and cookies ignore
# ports, so :8000 and :3000 already share them.
#
# In production the API and the app are sibling subdomains, and the session
# cookie has to be scoped to the parent for the app to send it back — and for
# the Next.js middleware to see the auth-hint cookie at all.
# SESSION_COOKIE_DOMAIN=.postly.com

# --- Frontend ---------------------------------------------------------------
# Where email confirmation and password-reset links point. No trailing slash.
FRONTEND_URL=http://localhost:3000
# Used when allauth builds absolute URLs. "https" in production.
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# --- Email ------------------------------------------------------------------
# Development ignores all of this: config/settings/dev.py uses the console
# backend, so verification and reset links print to the runserver terminal.
#
# Production values below are Resend's SMTP endpoint. For Postmark use
# smtp.postmarkapp.com with the server token as both user and password.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
# Resend: the literal string "resend".
EMAIL_HOST_USER=resend
# Resend: an API key beginning re_. This is a secret.
EMAIL_HOST_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified with the provider.
DEFAULT_FROM_EMAIL=Postly <hello@postly.com>

# --- Blog subscriptions -----------------------------------------------------
# Where mail to a blog's *readers* comes from, as opposed to account mail.
# Defaults to DEFAULT_FROM_EMAIL, which is fine to start with.
#
# Point it at a separate subdomain before you have real subscribers. A
# newsletter and a password reset sent from one domain share one sending
# reputation, so one writer's readers marking their posts as spam would start
# sending everybody's login mail to the junk folder.
# SUBSCRIPTION_FROM_EMAIL=Postly <posts@mail.postly.com>
#
# That subdomain needs its own DNS records, added at the registrar and then
# verified in the provider's dashboard. None of this is in the codebase, and
# without it bulk mail goes to spam whatever the application does:
#
#   SPF    TXT  mail.postly.com
#          "v=spf1 include:amazonses.com ~all"
#          (Resend's own value — copy whatever their dashboard shows, do not
#          guess. One SPF record per name; two is an error, not a merge.)
#
#   DKIM   TXT  resend._domainkey.mail.postly.com
#          The public key the provider generates. This is the record that
#          actually authenticates the message, and the one worth checking
#          first when mail starts landing in spam.
#
#   DMARC  TXT  _dmarc.mail.postly.com
#          "v=DMARC1; p=none; rua=mailto:dmarc@postly.com"
#          Start at p=none — it reports without rejecting. Read the reports
#          for a couple of weeks, confirm everything legitimate is passing,
#          then move to p=quarantine and later p=reject. Going straight to
#          p=reject silently bins your own mail.
#
# Gmail and Yahoo require SPF, DKIM, DMARC, one-click unsubscribe and a spam
# complaint rate under 0.3% from anyone sending bulk mail. The application
# sends the List-Unsubscribe headers already; the rest is these records.

# Minutes between a writer pressing Publish and their subscribers being
# emailed. The gap is what lets an unpublish catch a mistake before anyone
# sees it — mail, unlike a published page, cannot be taken back. Set to 0 to
# send on the next cron tick after publishing.
# POST_EMAIL_DELAY_MINUTES=15

# Queued post notifications are sent by a management command, not by the web
# process. Run it on a schedule — every minute is right, it exits immediately
# when there is nothing due:
#
#   */1 * * * *  cd /app && python manage.py send_pending_post_emails
#
# It is safe to run concurrently with itself and safe to re-run after a
# crash. Without it, publishing queues mail that never goes out.

# Most notification emails one blog may send per day. A blast-radius bound:
# every blog shares one sending reputation, so this is what stops a single
# bought list from spending it all at once. A send that hits the cap pauses
# and resumes the next day from where it stopped — nobody is skipped and
# nobody is mailed twice.
# POST_EMAIL_DAILY_CAP_PER_SITE=2000

# --- Provider webhooks ------------------------------------------------------
# The signing secret for Resend's webhook, from their dashboard — it starts
# with "whsec_". Point the webhook at:
#
#   https://api.postly.com/api/webhooks/resend/
#
# and subscribe it to `email.bounced` and `email.complained` at minimum.
#
# This is how dead addresses and spam complaints stop receiving mail. Neither
# of those people will ever click an unsubscribe link, and every further
# message to them is charged against the sending reputation every blog
# shares.
#
# Unset, the endpoint refuses every request rather than accepting unsigned
# ones. That is deliberate: without the signature check, anybody who learned
# the URL could unsubscribe any reader from every blog on the platform.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

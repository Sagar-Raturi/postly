# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# --- Core -------------------------------------------------------------------
# Required in production. Local dev falls back to an insecure built-in key.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database ---------------------------------------------------------------
# Omit entirely to use SQLite at postly-backend/db.sqlite3 (fine for a first run).
# Postgres:
# DATABASE_URL=postgres://postly:postly@localhost:5432/postly

# --- Hosts and CORS ---------------------------------------------------------
# Comma-separated. Required in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to call the API from a browser. The Next.js dev server:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CSRF_TRUSTED_ORIGINS=https://app.postly.com

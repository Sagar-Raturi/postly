# Copy to .env.local for local development.
# NEXT_PUBLIC_ variables are inlined into the browser bundle — never put
# secrets here.

# Base URL of the Postly Django API, as the *browser* should address it
# (no trailing slash).
#
# Locally that is the API's own address, because both halves are on
# localhost. Deployed it is the relative "/api", which next.config.ts
# proxies to POSTLY_API_ORIGIN below — that keeps every request on one
# origin, which is what lets a Lax session cookie work at all when the app
# and the API are hosted on different domains.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# The API's own origin — scheme and host, no path and no trailing slash:
#
#   POSTLY_API_ORIGIN=https://your-api.onrender.com
#
# Deployed environments only; leave it unset locally. Two things read it:
# next.config.ts, to know where to proxy /api/* to, and lib/public-api.ts,
# whose fetches run on the server and so need an absolute URL.
#
# Deliberately not NEXT_PUBLIC_: nothing in the browser should use it, and
# the prefix would ship it to the bundle and invite exactly that.
# POSTLY_API_ORIGIN=

# Where the "Published with Postly" credits on a published blog point.
#
# Left unset they use a relative "/", which reaches the marketing homepage
# because a blog is served from the same origin today. Point this at the
# real marketing domain once it exists AND has a valid certificate — an
# absolute URL here also makes the credits open in a new tab.
#
# Do not set this to https://postly.com unless you own it: that domain
# serves a certificate that does not name it, so every reader who clicks
# the credit gets a browser interstitial about an insecure connection.
# NEXT_PUBLIC_MARKETING_URL=https://postly.com

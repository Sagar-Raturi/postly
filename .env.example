# Copy to .env.local for local development.
# NEXT_PUBLIC_ variables are inlined into the browser bundle — never put
# secrets here.

# Base URL of the Postly Django API (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Where the "Published with Postly" credits on a published blog point.
#
# Left unset they use a relative "/", which reaches the marketing homepage
# because a blog is served from the same origin today. Point this at the
# real marketing domain once it exists AND has a valid certificate — an
# absolute URL here also makes the credits open in a new tab.
#
# Do not set this to https://postly.com unless you own it: that domain
# serves a certificate that does not name it, so every reader who clicks
# the credit gets a browser interstitial about an insecure connection.
# NEXT_PUBLIC_MARKETING_URL=https://postly.com

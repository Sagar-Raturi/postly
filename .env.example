# Copy to .env.local for local development.
# NEXT_PUBLIC_ variables are inlined into the browser bundle — never put
# secrets here.

# Base URL of the Codomain Django API, as the *browser* should address it
# (no trailing slash).
#
# Locally that is the API's own address, because both halves are on
# localhost. Deployed it is the relative "/api", which next.config.ts
# proxies to POSTLY_API_ORIGIN below — that keeps every request on one
# origin, which is what lets a Lax session cookie work at all when the app
# and the API are hosted on different domains.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# The API's own origin — scheme and host, no path and no trailing slash:
#
#   POSTLY_API_ORIGIN=https://your-api.onrender.com
#
# Deployed environments only; leave it unset locally. Two things read it:
# next.config.ts, to know where to proxy /api/* to, and lib/public-api.ts,
# whose fetches run on the server and so need an absolute URL.
#
# Deliberately not NEXT_PUBLIC_: nothing in the browser should use it, and
# the prefix would ship it to the bundle and invite exactly that.
# POSTLY_API_ORIGIN=

# The address shown on the Privacy and Terms pages and in the footer's
# contact links. Unset, it falls back to contact@codomain.in, which receives
# mail once Cloudflare Email Routing forwards it (deploy runbook 7.5).
# NEXT_PUBLIC_CONTACT_EMAIL=contact@codomain.in

# The domain whose subdomains are writers' blogs, e.g. codomain.blog. Unset,
# blogs are paths on this app (/sagar). Set it only after *.codomain.blog
# points at Vercel with a valid certificate (deploy runbook 7.9), and before
# BLOG_DOMAIN on Render. Read at build time: redeploy after changing it.
# Locally, blog.localhost:3000 works (see README, "Testing subdomains").
# NEXT_PUBLIC_BLOG_DOMAIN=codomain.blog

# The app's own public origin, used for canonical URLs and link previews.
# Unset, it is https://www.codomain.in, which is right for production and
# harmless locally.
# NEXT_PUBLIC_SITE_URL=https://www.codomain.in

# Where the "Published with Codomain" credits on a published blog point.
#
# Left unset they use a relative "/", which reaches the marketing homepage
# because a blog is served from the same origin today. Point this at the
# real marketing domain once it exists AND has a valid certificate — an
# absolute URL here also makes the credits open in a new tab.
#
# Only point it at a domain Codomain owns and serves with a valid
# certificate, or every reader who clicks the credit gets a browser warning
# about an insecure connection instead of the homepage.
# NEXT_PUBLIC_MARKETING_URL=https://www.codomain.in
